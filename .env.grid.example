# Public branding. All VITE_ values are compiled into the browser bundle.
# Set both origin variables to the deployed dashboard URL for custom domains.
VITE_GRID_PUBLIC_ORIGIN=
GRID_PUBLIC_ORIGIN=
VITE_GRID_CONTRACT_ADDRESS=
VITE_GRID_X_URL=
VITE_GRID_CHART_URL=
VITE_GRID_SOURCE_CODE_URL=
VITE_PMTILES_URL=

# Vercel or a native preview can use an operator-owned Redis REST cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WM_SESSION_SECRET=

# Compose needs independent random secrets. See SIGNAL_GRID.md.
REDIS_TOKEN=
REDIS_PASSWORD=
RELAY_SHARED_SECRET=
WM_PORT=3000

# Optional source credentials. Configure only providers you are authorized to use.
COINGECKO_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
ACLED_EMAIL=
ACLED_ACCESS_TOKEN=
UCDP_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=
NASA_FIRMS_API_KEY=
AISSTREAM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
WS_RELAY_URL=
